# pretix-agent-mcp configuration. Copy to .env (gitignored) or set these in your
# service unit / docker run. Environment variables win over the JSON config file.
# Defaults are closed: localhost bind, read-only, PII masked, no writes.

# --- pretix (required) -------------------------------------------------------
PRETIX_BASE_URL=https://tickets.example.org
# A restricted TEAM token. Give it the least permissions your capability set needs
# (see README). This value never leaves the server.
PRETIX_API_TOKEN=replace-me
# The organizer is pinned here, never supplied by the agent.
PRETIX_ORGANIZER=your-organizer-slug
# Optional: restrict to specific events (default: every event of the organizer).
#PRETIX_EVENT_ALLOWLIST=conf27,stammtisch

# --- MCP client credential (required for the HTTP transport) -----------------
# openssl rand -hex 32
MCP_BEARER_TOKEN=replace-me-with-at-least-24-characters

# --- what the agent may do ---------------------------------------------------
# read | write | write:high-risk  (comma separated). Default: read
#MCP_CAPABILITIES=read,write
# Optional: expose exactly these tools and nothing else (overrides the classes).
#MCP_TOOL_ALLOWLIST=list_events,get_event,sales_summary
# Optional: high-risk tools reclassified to plain `write` — no approval ceremony.
# An explicit, audited, per-tool decision. Keep refunds and deletions out of it.
#MCP_AUTO_APPROVE=publish_event

# --- privacy -----------------------------------------------------------------
# redacted (default) masks names, emails, addresses and phone numbers in results.
# full turns masking off for this deployment. Never a tool parameter.
#PII_MODE=redacted

# --- serving -----------------------------------------------------------------
#MCP_HOST=127.0.0.1
#MCP_PORT=8765
#LOG_LEVEL=info
# Host headers to accept besides the bind address. REQUIRED behind a reverse proxy:
# nginx and Caddy forward the public hostname, and without it listed here the server
# answers 421 Misdirected Request. Use * only if the proxy validates Host itself.
#MCP_ALLOWED_HOSTS=pretix-mcp.example.org

# Everything above can also live in a JSON config file; env wins over it.
#PRETIX_AGENT_CONFIG=/etc/pretix-agent-mcp/config.json

# --- state and audit ---------------------------------------------------------
#AUDIT_LOG=audit.jsonl
#STATE_DB=pending-actions.sqlite3
# How long a proposed high-risk action stays approvable.
#APPROVAL_TTL_SECONDS=900
# Order pages sales_summary will scan before it reports a truncated window.
#SALES_SCAN_CAP=5000
